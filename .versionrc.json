{
  "header": "# Changelog\n",
  "scripts": {
    "postchangelog": "node -e \"const fs = require('fs'); const f = 'CHANGELOG.md'; fs.writeFileSync(f, fs.readFileSync(f, 'utf8').replace(/(?<=[^\\n])\\n(?=## )/g, '\\n\\n'))\""
  },
  "types": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "hidden": true
    },
    {
      "type": "style",
      "hidden": true
    },
    {
      "type": "chore",
      "hidden": true
    },
    {
      "type": "refactor",
      "hidden": true
    },
    {
      "type": "test",
      "hidden": true
    },
    {
      "type": "build",
      "hidden": true
    },
    {
      "type": "ci",
      "hidden": true
    }
  ]
}
